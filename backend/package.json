{
  "name": "lifelink-backend",
  "version": "1.0.0",
  "description": "LifeLink backend: SD-JWT credentials, consent, verification, hash-chained audit",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/server.js",
    "dev": "tsx watch src/server.ts",
    "db:init": "tsx src/migrate.ts",
    "seed": "tsx src/seed.ts",
    "seed:reset": "tsx src/seed.ts --reset",
    "test:crypto": "tsx src/selftest.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jose": "^5.9.3",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.3"
  }
}
