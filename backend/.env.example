# Copy this file to `.env` and adjust the password if needed.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/gitlink

# Port for the API (the Vite dev server proxies/uses this too).
PORT=4000

# Public base URL of this API. It is embedded in every credential as the
# revocation status-list URL, so it must be reachable by a verifier.
APP_BASE_URL=http://localhost:4000

# Set to false if you prefer to apply schema.sql yourself with `npm run db:init`.
AUTO_MIGRATE=true

# Maximum pooled Postgres connections (use 1 for single-session test databases).
PG_POOL_MAX=10

# Secret that signs login session tokens.
# Set a long random value in production (anyone holding it can mint sessions).
AUTH_JWT_SECRET=change-me-production-secret

# Login session lifetime in seconds (default: 12 hours).
AUTH_TOKEN_TTL_SECONDS=43200

# AES-256 key (64 hex chars = 32 bytes) that encrypts issuer signing keys and
# custodial holder keys at rest. REQUIRED — the server refuses to start without
# it. Generate one with:  npm run gen:key
ISSUER_KEY_ENC_KEY=change-me-run-npm-run-gen-key

# Public origin allowed to call the API from a browser (strict CORS).
CORS_ORIGIN=http://localhost:5173
