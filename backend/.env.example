# Copy this file to `.env` and adjust the password if needed.
DATABASE_URL=postgres://postgres:postgres@localhost:5432/lifelink

# Port for the API (the Vite dev server proxies/uses this too).
PORT=4000

# Public base URL of this API. It is embedded in every credential as the
# revocation status-list URL, so it must be reachable by a verifier.
APP_BASE_URL=http://localhost:4000

# Set to false if you prefer to apply schema.sql yourself with `npm run db:init`.
AUTO_MIGRATE=true

# Maximum pooled Postgres connections (use 1 for single-session test databases).
PG_POOL_MAX=10
